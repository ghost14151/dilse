rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function chatMember(chatId) {
      return verifiedUser()
        && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId))
            .data.participants;
    }

    match /users/{userId} {
      allow read: if verifiedUser();
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'photoUrl',
          'searchName', 'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if verifiedUser()
        && request.auth.uid in resource.data.participants;

      allow create: if verifiedUser()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if verifiedUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants
          == resource.data.participants;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);

        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'createdAt'
          ]);

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if verifiedUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.reason is string;
      allow read, update, delete: if false;
    }
  }
}