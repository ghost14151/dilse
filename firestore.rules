rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function chatMember(chatId) {
      return verifiedUser()
        && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId))
            .data.participants;
    }


    function notBlocked(chatId) {
      let participants = get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      let other = participants[0] == request.auth.uid ? participants[1] : participants[0];
      return !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + other))
        && !exists(/databases/$(database)/documents/blocks/$(other + '_' + request.auth.uid));
    }

    function hasActiveSubscription(uid) {
      let path = /databases/$(database)/documents/subscriptions/$(uid);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.expiresAt is timestamp
        && get(path).data.expiresAt > request.time;
    }

    function isAdmin() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasFreeChatAccess(uid) {
      let path = /databases/$(database)/documents/freeChatAccess/$(uid);
      return exists(path) && get(path).data.active == true;
    }

    function matchingUsageMessage() {
      let path = /databases/$(database)/documents/chats/$(request.resource.data.lastChatId)/messages/$(request.resource.data.lastMessageId);
      return getAfter(path).data.senderId == request.auth.uid;
    }

    match /admins/{adminId} {
      allow read: if verifiedUser() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /freeChatAccess/{userId} {
      allow read: if verifiedUser()
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'active', 'grantedBy', 'updatedAt'
        ])
        && request.resource.data.active is bool
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /users/{userId} {
      match /fcmTokens/{tokenId} {
        allow read: if false;
        allow create, update: if verifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.updatedAt == request.time;
        allow delete: if verifiedUser()
          && request.auth.uid == userId;
      }

      allow read: if verifiedUser();
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'photoUrl', 'avatarId',
          'searchName', 'createdAt', 'updatedAt',
          'ageNoticeAccepted', 'ageOver18', 'ageNoticeAcceptedAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if verifiedUser()
        && request.auth.uid in resource.data.participants;

      allow create: if verifiedUser()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow update: if verifiedUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants
          == resource.data.participants;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);

        allow create: if chatMember(chatId)
          && notBlocked(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.auth.uid in request.resource.data.readBy
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'createdAt', 'readBy'
          ])
          && (
            (hasActiveSubscription(request.auth.uid) || hasFreeChatAccess(request.auth.uid))
            || (
              getAfter(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.messagesSent <= 10
              && getAfter(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.lastChatId == chatId
              && getAfter(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.lastMessageId == messageId
              && (
                (!exists(/databases/$(database)/documents/chatUsage/$(request.auth.uid))
                  && getAfter(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.messagesSent == 1)
                ||
                (exists(/databases/$(database)/documents/chatUsage/$(request.auth.uid))
                  && get(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.messagesSent < 10
                  && getAfter(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.messagesSent
                    == get(/databases/$(database)/documents/chatUsage/$(request.auth.uid)).data.messagesSent + 1)
              )
            )
          );

        allow update: if chatMember(chatId) && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.auth.uid != resource.data.senderId
            && request.resource.data.readBy is list
            && request.auth.uid in request.resource.data.readBy
            && (
              (!('readBy' in resource.data.keys())
                && request.resource.data.readBy.size() == 1)
              ||
              ('readBy' in resource.data.keys()
                && resource.data.readBy is list
                && request.resource.data.readBy.toSet().hasAll(resource.data.readBy.toSet())
                && request.resource.data.readBy.toSet().size() == resource.data.readBy.toSet().size() + 1
                && !(request.auth.uid in resource.data.readBy))
            )
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt is timestamp
          )
        );

        allow delete: if chatMember(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /chatUsage/{userId} {
      allow read: if verifiedUser() && request.auth.uid == userId;

      allow create: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'messagesSent', 'lastChatId', 'lastMessageId', 'updatedAt'
        ])
        && request.resource.data.messagesSent == 1
        && request.resource.data.lastChatId is string
        && request.resource.data.lastMessageId is string
        && matchingUsageMessage();

      allow update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'messagesSent', 'lastChatId', 'lastMessageId', 'updatedAt'
        ])
        && resource.data.messagesSent < 10
        && request.resource.data.messagesSent == resource.data.messagesSent + 1
        && request.resource.data.lastChatId is string
        && request.resource.data.lastMessageId is string
        && matchingUsageMessage();

      allow delete: if false;
    }

    match /subscriptions/{userId} {
      allow read: if verifiedUser() && request.auth.uid == userId;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow get: if verifiedUser()
        && (!exists(/databases/$(database)/documents/friendRequests/$(requestId))
            || resource.data.senderId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);

      allow list: if verifiedUser()
        && (resource.data.senderId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'senderId', 'receiverId', 'senderName', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.receiverId
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'senderId', 'receiverId', 'senderName', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.senderName == resource.data.senderName
        && requestId == resource.data.senderId + '_' + resource.data.receiverId
        && (
          (request.auth.uid == resource.data.receiverId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time)
          ||
          (request.auth.uid == resource.data.senderId
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time)
          ||
          (request.auth.uid in [resource.data.senderId, resource.data.receiverId]
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'ended'
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time)
        );

      allow delete: if false;
    }

    match /blocks/{blockId} {
      // Allow checking a missing block record; existing records stay private.
      allow read: if verifiedUser()
        && (!exists(/databases/$(database)/documents/blocks/$(blockId))
            || resource.data.blockerId == request.auth.uid
            || resource.data.blockedUserId == request.auth.uid);

      allow create: if verifiedUser()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'blockerId', 'blockedUserId', 'createdAt'
        ])
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUserId;

      allow update: if false;
      allow delete: if verifiedUser()
        && resource.data.blockerId == request.auth.uid;
    }


    match /dailyStreaks/{userId} {
      allow read: if verifiedUser()
        && request.auth.uid == userId;
      // Only trusted server code may create or change streaks/rewards.
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if verifiedUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.reason is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}